{
  "name": "mailcheap-migma",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:migrate --silent && next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "preview": "npm run db:migrate --silent && opennextjs-cloudflare build && opennextjs-cloudflare preview --port 3100",
    "deploy": "npm run db:migrate:remote --silent || true; opennextjs-cloudflare build && opennextjs-cloudflare deploy && npm run db:migrate:remote",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tiptap/extension-file-handler": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "migma": "^1.9.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "wrangler": "^4.149.0"
  }
}
