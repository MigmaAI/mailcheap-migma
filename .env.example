# Copy to .env.local for local development. On a host, add these as environment variables.
# Sending, domains, contacts, bounces, unsubscribes and tracking are all Migma's: no AWS, no queue, no Redis.

# ─── Required ──────────────────────────────────────────────────────────────────

# Signs sessions and encrypts each connected account's Migma key. At least 32 random characters:
# openssl rand -base64 48. Changing it signs everyone out and every account connects Migma again.
SESSION_SECRET=

# MongoDB for drafts, newsletter settings and the archive (contacts live in Migma). Locally,
# `npm run dev:local` starts one for you and this can stay empty.
MONGODB_URI=

# ─── App ───────────────────────────────────────────────────────────────────────

# Public URL of this app: archive links, "Read online" links and the Migma sign-in callback
# (APP_URL/auth/migma/callback). No trailing slash. On Vercel it defaults to the production domain.
APP_URL=http://localhost:3100

# Kill switch: nothing is sent or tested unless this is exactly "true".
SENDING_ENABLED=false

# ─── Migma (optional) ──────────────────────────────────────────────────────────

# The Migma API. Leave empty for https://api.migma.ai/v1.
MIGMA_API_URL=

# "Continue with Migma" registers this app with Migma's OAuth server on first use. Set this to use a
# client id you registered yourself instead.
MIGMA_OAUTH_CLIENT_ID=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Archive domains: news.example.com=weekly serves the "weekly" newsletter's archive at that domain.
# Comma-separated for several newsletters. Point the domain at this app first. It's the safer setup:
# issue HTML then never shares the dashboard's origin, and APP_URL/archive/weekly redirects there.
ARCHIVE_HOSTS=

# Upstash Redis: rate limits shared by every server instance. Without it, the same limits are counted
# in each instance's memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob: image uploads in the editor. Without it, uploads are off; HTML campaigns can still use
# images hosted anywhere.
BLOB_READ_WRITE_TOKEN=
